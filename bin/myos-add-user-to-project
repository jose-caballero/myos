#!/usr/bin/python3

from myos.user import User
from myos.project import Project


# Get project name or ID
project_name = input("Enter project name (leave blank if you are going to provide the project ID): ").strip()
if not project_name:
    project_id = input("Enter project ID: ").strip()
    if not project_id:
        print("Either project name or project ID must be provided")
        exit()
else:
    project_id = None

# Get user name or ID
user_name = input("Enter user name (leave blank if you are going to provide the user ID): ").strip()
if not user_name:
    user_id = input("Enter user ID: ").strip()
    if not user_id:
        print("Either user name or user ID must be provided")
        exit()
else:
    user_id = None

# Get domain
domain_name = input("Enter domain name: ").strip()


user = User(user_id=user_id, name=user_name, domain_name=domain_name)
#project = Project(project_id=project_id, name=project_name)
#project.add(user)
